{
  "functions": [{ "source": "artifacts/firebase-functions", "codebase": "shield", "runtime": "nodejs22", "ignore": ["node_modules", "*.log", ".env*", ".git"] }],
  "firestore": { "database": "(default)", "location": "us-central1", "rules": "deploy/firebase/firestore.rules", "indexes": "deploy/firebase/firestore.indexes.json" },
  "emulators": { "firestore": { "host": "127.0.0.1", "port": 8089 }, "ui": { "enabled": false }, "singleProjectMode": true },
  "hosting": {
    "site": "shield-calls-isaac",
    "public": "deploy/firebase/public",
    "ignore": ["firebase.json", "**/node_modules/**"],
    "appAssociation": "NONE",
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ] },
      { "source": "/speech/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "/.well-known/apple-app-site-association", "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ] }
    ],
    "rewrites": [
      { "source": "/{api,auth,trial,forwarding,public}/**", "function": { "functionId": "shieldApi", "region": "us-central1" } },
      { "source": "/{privacy,service-info}", "function": { "functionId": "shieldApi", "region": "us-central1" } }
    ]
  }
}
