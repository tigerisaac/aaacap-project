      "html": "<button class=\"ds-secondary\" type=\"button\">Allow calls again</button>",
      "css": ".ds-secondary{width:100%;max-width:360px;white-space:normal;min-height:52px;padding:12px 18px;border:0;border-radius:999px;background:#E7EBF1;color:#002664;font:600 1rem system-ui;cursor:pointer}.ds-secondary:hover{filter:brightness(.96)}.ds-secondary:focus-visible{outline:2px solid #002664;outline-offset:3px}.ds-secondary:active{filter:brightness(.9)}.ds-secondary:disabled{background:ButtonFace;color:#101E32;cursor:default}@media(prefers-color-scheme:dark){.ds-secondary{background:#28364A;color:#B9CDF2}}@media(prefers-contrast:more){.ds-secondary{background:#DCE2EA;color:#001A45}}@media(prefers-color-scheme:dark) and (prefers-contrast:more){.ds-secondary{background:#34465F;color:#D6E4FF}}"
