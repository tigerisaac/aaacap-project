      "html": "<span class=\"ds-outcome\"><svg aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 10v4m4-7v10m5-14v18m5-14v10m4-7v4\"/></svg><span>Message</span></span>",
