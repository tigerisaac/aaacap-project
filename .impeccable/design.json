    {
      "name": "Home calls stopped panel",
      "kind": "card",
      "refersTo": "home-stopped-calls",
      "description": "Schematic documentation preview; native SwiftUI remains authoritative. Browser pixels, typography, symbols, corners, focus and hover feedback are illustrative. Positive historical total uses an Action native row and serif numeral; zero/missing uses Card and explicit text. It is neither current protection nor proof of confirmed scams. Synthetic numeral. Source: Features/Overview/StoppedCallsCard.swift.",
      "html": "<button class=\"ds-stopped\" type=\"button\" aria-label=\"Calls stopped. 3 in total.\"><span class=\"ds-stopped-heading\"><strong>Calls stopped</strong><svg aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 12V7a1.5 1.5 0 0 1 3 0v4-7a1.5 1.5 0 0 1 3 0v7-6a1.5 1.5 0 0 1 3 0v7-3a1.5 1.5 0 0 1 3 0v7c0 4-3 6-6 6-3 0-5-2-7-5l-3-4a1.7 1.7 0 0 1 2-2l2 3\"/></svg></span><span class=\"ds-stopped-count\">3</span><span>Total</span><span class=\"ds-stopped-action\">See calls <svg aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></span></button>",
      "css": ".ds-stopped{display:grid;gap:12px;min-height:52px;width:100%;max-width:360px;padding:20px;border:0;border-radius:16px;background:#002664;color:white;font:1rem system-ui;text-align:left;cursor:pointer;white-space:normal}.ds-stopped-heading{display:flex;align-items:baseline;justify-content:space-between;gap:12px;font-size:1.25rem}.ds-stopped-heading svg{width:22px;height:22px;flex-shrink:0}.ds-stopped-count{font-size:3.4rem;font-family:ui-serif,serif;font-weight:400;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.ds-stopped-action{display:flex;align-items:center;gap:8px;font-weight:600}.ds-stopped-action svg{width:18px;height:18px}.ds-stopped:hover{filter:brightness(.96)}.ds-stopped:focus-visible{outline:2px solid #002664;outline-offset:3px}.ds-stopped:active{filter:brightness(.9)}@media(prefers-color-scheme:dark){.ds-stopped{background:#B9CDF2;color:rgb(8% 12% 22%)}.ds-stopped:focus-visible{outline-color:#B9CDF2}}@media(prefers-contrast:more){.ds-stopped{background:#001A45}}@media(prefers-color-scheme:dark) and (prefers-contrast:more){.ds-stopped{background:#D6E4FF}}"
    },
    {
      "name": "Full-row native switch",
      "kind": "custom",
      "refersTo": "switch-row",
      "description": "Schematic documentation preview; native SwiftUI remains authoritative. Browser pixels, typography, symbols, corners, focus and hover feedback are illustrative. Full labeled 52-point minimum row is tappable; one native accessibility Toggle represents the control. Source behavior does not prove VoiceOver approval. Source: Design/ShieldSwitchStyle.swift.",
      "html": "<label class=\"ds-switch-row\"><span>Check calls while I talk</span><input class=\"ds-switch\" type=\"checkbox\" role=\"switch\" checked aria-label=\"Check calls while I talk\"></label>",
      "css": ".ds-switch-row{display:flex;align-items:center;gap:16px;width:100%;max-width:360px;min-height:52px;color:#101E32;font:600 1rem system-ui;cursor:pointer}.ds-switch-row>span{flex:1;white-space:normal}.ds-switch{appearance:none;position:relative;flex-shrink:0;width:51px;height:31px;margin:0;border:1px solid GrayText;border-radius:18px;background:ButtonFace;cursor:pointer}.ds-switch::after{content:\"\";position:absolute;top:2px;left:2px;width:25px;height:25px;border-radius:50%;background:#FFFFFF}.ds-switch:checked{background:#002664;border-color:#002664}.ds-switch:checked::after{left:22px;background:#fff}.ds-switch-row:hover .ds-switch{filter:brightness(.96)}.ds-switch:focus-visible{outline:2px solid #002664;outline-offset:3px}.ds-switch:active{filter:brightness(.9)}.ds-switch:disabled{cursor:default;background:ButtonFace;border-color:GrayText}@media(prefers-color-scheme:dark){.ds-switch:checked{background:#B9CDF2;border-color:#B9CDF2}.ds-switch:checked::after{background:rgb(8% 12% 22%)}.ds-switch:focus-visible{outline-color:#B9CDF2}}@media(prefers-color-scheme:dark){.ds-switch-row{color:#F3F6FB}}"
    }
