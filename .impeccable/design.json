  "components": [
    {
      "name": "Native primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Schematic documentation preview; native SwiftUI remains authoritative. Browser pixels, typography, symbols, corners, focus and hover feedback are illustrative. Native large prominent capsule, wrapping headline, minimum 52-point label; adaptive navy/pale Action and Action ink. Source: Design/ShieldComponents.swift.",
      "html": "<button class=\"ds-primary\" type=\"button\">Listen to message</button>",
      "css": ".ds-primary{width:100%;max-width:360px;min-height:52px;padding:12px 20px;border:0;border-radius:999px;background:#002664;color:white;font:600 1rem system-ui;white-space:normal;cursor:pointer}.ds-primary:hover{filter:brightness(.96)}.ds-primary:focus-visible{outline:2px solid #002664;outline-offset:3px}.ds-primary:active{filter:brightness(.9)}.ds-primary:disabled{background:ButtonFace;color:#101E32;cursor:default}@media(prefers-color-scheme:dark){.ds-primary{background:#B9CDF2;color:rgb(8% 12% 22%)}.ds-primary:focus-visible{outline-color:#B9CDF2}}@media(prefers-contrast:more){.ds-primary{background:#001A45}.ds-primary:focus-visible{outline-color:#001A45}}@media(prefers-color-scheme:dark) and (prefers-contrast:more){.ds-primary{background:#D6E4FF}.ds-primary:focus-visible{outline-color:#D6E4FF}}"
    },
