    {
      "name": "Email field",
      "kind": "input",
      "refersTo": "input-email",
      "description": "Schematic documentation preview; native SwiftUI remains authoritative. Browser pixels, typography, symbols, corners, focus and hover feedback are illustrative. Labeled, vertically growing email field on Card, with FieldBorder at rest and thicker Action focus boundary. Native keyboard/content type and Clear action are in source. Source: Features/Auth/SignInView.swift.",
      "html": "<label class=\"ds-email-label\">Your email<input class=\"ds-email\" type=\"email\" placeholder=\"you@example.com\" autocomplete=\"email\"></label>",
      "css": ".ds-email-label{display:grid;gap:8px;max-width:100%;color:#101E32;font:600 .9375rem system-ui}.ds-email{font:1rem system-ui;max-width:100%;width:260px;min-height:52px;padding:16px;color:#101E32;background:#FFFFFF;border:1px solid #7C8B9E;border-radius:14px}.ds-email::placeholder{color:rgb(32% 37% 44%);opacity:1}.ds-email:hover{border-color:#002664}.ds-email:focus-visible{outline:2px solid #002664;outline-offset:-2px}.ds-email:disabled{opacity:.5}@media(prefers-color-scheme:dark){.ds-email-label,.ds-email{color:#F3F6FB}.ds-email{background:#1C293B;border-color:#6B7D97}.ds-email::placeholder{color:rgb(72% 77% 84%)}.ds-email:focus-visible{outline-color:#B9CDF2}}@media(prefers-contrast:more){.ds-email{border-width:2px;border-color:#607188}}@media(prefers-color-scheme:dark) and (prefers-contrast:more){.ds-email{border-color:#95A6BD}}"
    },
    {
      "name": "Four native tabs",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Schematic documentation preview; native SwiftUI remains authoritative. Browser pixels, typography, symbols, corners, focus and hover feedback are illustrative. Home, Calls, Messages and More native tabs use familiar sans labels. Navigation titles remain native sans; custom content headings use serif. Person context moves into content at accessibility sizes. Source: App/RootView.swift, Design/PersonContextSection.swift and Navigation/NavigationShell.swift.",
      "html": "<nav class=\"ds-tabs\" aria-label=\"Shield destinations\"><button type=\"button\" aria-current=\"page\"><svg aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m3 11 9-8 9 8M5 10v11h5v-7h4v7h5V10\"/></svg><span>Home</span></button><button type=\"button\"><svg aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 3h4l2 5-3 2a16 16 0 0 0 6 6l2-3 5 2v4c0 2-2 3-4 2C9 19 5 15 3 7 2 5 3 3 5 3z\"/></svg><span>Calls</span></button><button type=\"button\"><svg aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 4h14l3 12v5H2v-5zM2 16h6l2 3h4l2-3h6\"/></svg><span>Messages</span></button><button type=\"button\"><svg aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"5\" cy=\"12\" r=\"1\"/><circle cx=\"12\" cy=\"12\" r=\"1\"/><circle cx=\"19\" cy=\"12\" r=\"1\"/></svg><span>More</span></button></nav>",
      "css": ".ds-tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));width:100%;max-width:390px;padding:8px;background:#F2F3F4}.ds-tabs button{display:grid;justify-items:center;gap:4px;min-height:52px;padding:6px 4px;border:0;border-radius:8px;background:transparent;color:rgb(32% 37% 44%);font:500 .75rem system-ui;cursor:pointer}.ds-tabs svg{width:22px;height:22px}.ds-tabs button[aria-current]{color:#002664}.ds-tabs button:hover{background:rgb(0 38 100 / .08)}.ds-tabs button:focus-visible{outline:2px solid #002664}.ds-tabs button:active{background:rgb(0 38 100 / .12)}@media(prefers-color-scheme:dark){.ds-tabs button{color:rgb(72% 77% 84%)}.ds-tabs button[aria-current]{color:#B9CDF2}}@media(prefers-color-scheme:dark){.ds-tabs{background:#101B2B}}"
