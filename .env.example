# Local demo never places calls and only binds to loopback.
NODE_ENV=development
SHIELD_MODE=demo
HOST=127.0.0.1
PORT=3000
# Set only for a known proxy chain with direct access to this port blocked.
TRUSTED_PROXY_HOPS=0
PUBLIC_BASE_URL=http://127.0.0.1:3000
DATABASE_URL=
EMBEDDED_DB_PATH=.data/shield
# npm run demo:setup generates these locally. Never commit real values.
DATA_ENCRYPTION_KEY=
DEMO_ACCESS_TOKEN=

# Live deployment requires PostgreSQL, HTTPS, managed auth, and real keys.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
# Legacy Supabase adapter is used only when AUTH_PROVIDER=supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SCREENING_PROVIDER=openai
OPENAI_API_KEY=
# Set to the model you have evaluated; no implicit production model.
OPENAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
MODEL_TIMEOUT_MS=3500
LIVE_OFFERING_ENABLED=false
SMS_CLASSIFICATION_ENABLED=false
CALLBACK_TIMEOUT_SECONDS=15
MAX_BRIDGE_SECONDS=1200
MAX_VOICEMAIL_SECONDS=120
MAX_CALLBACKS_PER_PARTICIPANT_DAY=10
MAX_CALLBACKS_PER_DAY=100
MAX_SCREENINGS_PER_PARTICIPANT_DAY=40
MAX_CLASSIFICATIONS_PER_DAY=500
RETENTION_DAYS=30
APPLE_TEAM_ID=
IOS_BUNDLE_ID=org.isaaczhang.Shield
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_PRODUCTION=false
SUPPORT_EMAIL=
