# Copy to .env.twilio-trial (gitignored). Keep the existing .env unchanged.
NODE_ENV=development
TRIAL_PORT=3001
TRIAL_PUBLIC_BASE_URL=https://YOUR-TEMPORARY-HOST.trycloudflare.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TRIAL_TWILIO_NUMBER=
TRIAL_VERIFIED_CALLER=
TRIAL_MAX_CALLS=10
TRIAL_SESSION_MINUTES=60
TRIAL_SCREENING_ENABLED=false
# Optional compatibility for the trial interceptor; 64 random lowercase hex characters.
# Leave empty for standard Twilio signature authentication. See docs/TWILIO-TRIAL.md.
TRIAL_PROXY_SECRET=
