<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>aps-environment</key><string>$(SHIELD_APNS_ENVIRONMENT)</string>
    <key>com.apple.security.application-groups</key><array><string>group.$(SHIELD_APP_BUNDLE_ID)</string></array>
    <key>com.apple.developer.associated-domains</key><array>
        <string>messagefilter:$(SHIELD_MESSAGE_FILTER_HOST)</string>
        <string>applinks:$(SHIELD_AUTH_HOST)</string>
    </array>
</dict></plist>
