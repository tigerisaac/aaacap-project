{
  "name": "shield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "overrides": {
    "gaxios@6": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env backend/src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p backend/tsconfig.json",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:setup": "tsx backend/scripts/setup-demo.ts",
    "trial:voice": "tsx --env-file=.env.twilio-trial --env-file-if-exists=.env.openrouter --env-file-if-exists=.env.speech backend/src/trial-main.ts",
    "speech:prepare": "tsx --env-file-if-exists=.env.speech backend/scripts/prepare-speech.ts",
    "operator": "tsx --env-file-if-exists=.env backend/src/operator-main.ts",
    "ios:generate": "node scripts/generate-xcode-project.mjs",
    "firebase:package": "npm run build && node scripts/package-firebase.mjs",
    "test:firebase": "firebase emulators:exec --only firestore --project demo-shield 'npx vitest run backend/tests/cloud.test.ts backend/tests/forwarding.test.ts backend/tests/monitoring.test.ts'",
    "eval:model": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.openrouter backend/scripts/evaluate-model.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/formbody": "9.0.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.5",
    "firebase-admin": "14.4.0",
    "firebase-functions": "7.4.0",
    "jose": "6.2.12",
    "libphonenumber-js": "1.13.13",
    "openai": "7.20.0",
    "pg": "8.23.0",
    "twilio": "6.1.1",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
